# Copy to .env for local development. Never commit real secrets.
CIP_ENVIRONMENT=development
CIP_LOG_LEVEL=INFO
CIP_DATABASE_URL=postgresql+psycopg://cip:cip@localhost:5432/cip
CIP_SOURCE_REGISTRY_PATH=policies/sources.example.yml
CIP_IDENTITY_SOURCE_REGISTRY_PATH=policies/identity_sources.yml
CIP_ADVISORY_SOURCE_REGISTRY_PATH=policies/sources.advisories.yml
CIP_CORPORATE_CHANGE_SOURCE_REGISTRY_PATH=policies/sources.corporate_changes.yml
CIP_CONDITIONAL_INTEGRATION_SOURCE_REGISTRY_PATH=policies/sources.conditional_integrations.yml
CIP_PROVIDER_ONBOARDING_REGISTRY_PATH=policies/provider_onboarding.yml
CIP_SOURCE_PORTFOLIO_PATH=policies/source_portfolio.yml
CIP_ADVISORY_SOURCE_PORTFOLIO_PATH=policies/source_portfolio.advisories.yml
CIP_CORPORATE_CHANGE_SOURCE_PORTFOLIO_PATH=policies/source_portfolio.corporate_changes.yml
CIP_CONDITIONAL_INTEGRATION_SOURCE_PORTFOLIO_PATH=policies/source_portfolio.conditional_integrations.yml
CIP_GREENHOUSE_BOARD_REGISTRY_PATH=policies/greenhouse_boards.yml
CIP_LEVER_SITE_REGISTRY_PATH=policies/lever_sites.yml
CIP_SMARTRECRUITERS_COMPANY_REGISTRY_PATH=policies/smartrecruiters_companies.yml
CIP_ORGANIZATION_IDENTITY_TARGET_REGISTRY_PATH=policies/organization_identity_targets.yml
CIP_RETENTION_POLICY_PATH=policies/retention.yml
CIP_COLLECTION_SCHEDULE_PATH=policies/collection_schedules.yml

# Automatic public-web collection is disabled unless an operator explicitly approves
# organization UUIDs and records a reviewed authorization reference.
CIP_AUTOMATIC_PUBLIC_WEB_ENABLED=false
CIP_AUTOMATIC_PUBLIC_WEB_ORGANIZATION_IDS=[]
# CIP_AUTOMATIC_PUBLIC_WEB_AUTHORIZATION_REFERENCE=deployment-change-or-ticket
# CIP_AUTOMATIC_PUBLIC_WEB_REVIEWED_AT=2026-08-13T18:00:00Z
# CIP_AUTOMATIC_PUBLIC_WEB_EXPIRES_AT=2027-08-13T18:00:00Z
CIP_AUTOMATIC_PUBLIC_WEB_REFRESH_INTERVAL_SECONDS=86400
CIP_AUTOMATIC_PUBLIC_WEB_MAX_LINK_DEPTH=1
CIP_AUTOMATIC_PUBLIC_WEB_MAX_PAGES=100
CIP_AUTOMATIC_PUBLIC_WEB_MAX_TOTAL_BYTES=10000000
CIP_AUTOMATIC_PUBLIC_WEB_MAX_RESOURCE_BYTES=1000000
CIP_AUTOMATIC_PUBLIC_WEB_MAX_REDIRECTS=3
# Whole-crawl wall-clock guard and same-origin crawl concurrency. The default
# concurrency remains serial until a deployment explicitly opts in.
CIP_AUTOMATIC_PUBLIC_WEB_CRAWL_DEADLINE_SECONDS=300
CIP_AUTOMATIC_PUBLIC_WEB_MAX_CRAWL_CONCURRENCY=1

# Browser fallback is a separate opt-in authorization. Static HTTP approval alone
# never permits Chromium rendering.
CIP_AUTOMATIC_PUBLIC_WEB_BROWSER_ENABLED=false
# CIP_AUTOMATIC_PUBLIC_WEB_BROWSER_AUTHORIZATION_REFERENCE=browser-deployment-change
# CIP_AUTOMATIC_PUBLIC_WEB_BROWSER_REVIEWED_AT=2026-08-13T18:00:00Z
# CIP_AUTOMATIC_PUBLIC_WEB_BROWSER_EXPIRES_AT=2027-08-13T18:00:00Z
CIP_AUTOMATIC_PUBLIC_WEB_BROWSER_MIN_STATIC_TEXT_CHARS=200
CIP_AUTOMATIC_PUBLIC_WEB_BROWSER_MAX_PAGES=3

CIP_CONTROL_PLANE_TOKEN=development-control-token
CIP_SCHEDULER_POLL_SECONDS=5
CIP_WORKER_POLL_SECONDS=2
CIP_SOURCE_HTTP_TIMEOUT_SECONDS=30
CIP_API_HOST=127.0.0.1
CIP_API_PORT=8000
CIP_API_RELOAD=true

# Next.js server-side requests use the same protected control-plane token.
CIP_API_BASE_URL=http://127.0.0.1:8000

# Secret values stay outside Git. Provider onboarding stores only references such as:
# env://CIP_INPI_RNE_USERNAME
# env://CIP_INPI_RNE_PASSWORD
# file-secret:///run/secrets/inpi-rne-password

POSTGRES_DB=cip
POSTGRES_USER=cip
POSTGRES_PASSWORD=cip
